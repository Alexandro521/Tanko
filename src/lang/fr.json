            "description": "Un protocole moderne et performant qui transfère les données d'image à l'aide de séquences d'échappement base64, prenant en charge les couleurs vraies, les animations et la superposition avancée de calques."
          },
          "sixel": {
            "name": "Sixel",
            "description": "Un ancien format graphique bitmap, développé à l'origine par DEC, qui code les images sous forme de motifs de blocs verticaux de six pixels de haut, compatible avec de nombreux émulateurs de terminal."
          },
          "iterm2": {
            "name": "Iterm2",
            "description": "Un protocole d'image en ligne introduit par iTerm2 qui utilise des séquences d'échappement codées en base64 pour afficher des images directement dans la fenêtre du terminal."
          },
          "ascii": {
            "name": "Ascii",
            "description": "A universal fallback method that approximates visual data by translating image pixels into standard text characters of varying densities and colors."
          }
        },
