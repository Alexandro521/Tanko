        "img_protocols": {
          "kitty": {
            "name": "Kitty",
            "description": "Un protocolo moderno y de alto rendimiento que transfiere datos de imagen mediante secuencias de escape base64, compatible con color real, animaciones y superposición avanzada de capas."
          },
          "sixel": {
            "name": "Sixel",
            "description": "Un formato gráfico de mapa de bits antiguo, desarrollado originalmente por DEC, que codifica imágenes como patrones de bloques verticales de seis píxeles de altura, compatible con muchos emuladores de terminal."
          },
          "iterm2": {
            "name": "Iterm2",
            "description": "Un protocolo de imagen en línea introducido por iTerm2 que utiliza secuencias de escape codificadas en base64 para mostrar imágenes directamente dentro de la ventana del terminal."
          },
          "ascii": {
            "name": "Ascii",
            "description": "A universal fallback method that approximates visual data by translating image pixels into standard text characters of varying densities and colors."
          }
        },
        "page_preloading_strategy": {
          "around": {
            "title": "Around",
            "description": "Precarga las páginas que rodean la página actual en un rando prederterminado"
          },
          "fill": {
            "title": "Fill",
            "description": "Similar a rellenar huecos vacios este metodo tratara de precargar caulquier imagen que aun no este en los buffer de cache"
          },
          "forward": {
            "title": "Forward",
            "description": "Precarga solo la un numero determinado de pagina que este por delante de la pagina actual"
          }
        },
