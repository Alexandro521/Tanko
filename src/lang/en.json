            "name": "Kitty",
            "description": "A modern, high-performance protocol that transfers image data using base64 escape sequences, supporting true color, animations, and advanced layer blending."
          },
          "sixel": {
            "name": "Sixel",
            "description": "An older bitmap graphics format, originally developed by DEC, encoding images as vertical six-pixel high block patterns, supported by many terminal emulators."
          },
          "iterm2": {
            "name": "Iterm2",
            "description": "An inline image protocol introduced by iTerm2 that uses base64-encoded escape sequences to display images directly within the terminal window."
          },
          "ascii": {
            "name": "Ascii",
            "description": "A universal fallback method that approximates visual data by translating image pixels into standard text characters of varying densities and colors."
          }
